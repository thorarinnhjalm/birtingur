{
  "name": "@ada/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @ada/shared build && tsc",
    "dev": "tsx watch src/dev.ts",
    "seed": "tsx src/scripts/seed.ts",
    "rescan-creatives": "tsx src/scripts/rescan-creatives.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@ada/shared": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@hono/node-server": "^2.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "@upstash/redis": "^1.31.0",
    "firebase-admin": "^12.1.0",
    "hono": "^4.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vercel": "^34.0.0",
    "vitest": "^1.5.0"
  }
}
