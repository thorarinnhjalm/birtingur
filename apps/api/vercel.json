{
  "buildCommand": "pnpm build",
  "devCommand": "tsc --watch",
  "framework": null,
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/cron-accrue.js": { "maxDuration": 60 },
    "api/cron-aggregate.js": { "maxDuration": 60 },
    "api/cron-payouts.js": { "maxDuration": 60 },
    "api/cron-refresh-cache.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron-accrue", "schedule": "*/15 * * * *" },
    { "path": "/api/cron-aggregate", "schedule": "0 * * * *" },
    { "path": "/api/cron-payouts", "schedule": "0 6 1 * *" },
    { "path": "/api/cron-refresh-cache", "schedule": "*/10 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/cron-accrue", "destination": "/api/cron-accrue" },
    { "source": "/api/cron-aggregate", "destination": "/api/cron-aggregate" },
    { "source": "/api/cron-payouts", "destination": "/api/cron-payouts" },
    { "source": "/api/cron-refresh-cache", "destination": "/api/cron-refresh-cache" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
