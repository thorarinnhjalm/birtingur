{
  "ignoreCommand": "npx turbo-ignore @ada/api",
  "buildCommand": "pnpm build",
  "devCommand": "tsc --watch",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@expo-google-fonts/inter/**/*.ttf"
    },
    "api/cron-accrue.js": {
      "maxDuration": 60
    },
    "api/cron-aggregate.js": {
      "maxDuration": 60
    },
    "api/cron-diagnostics.js": {
      "maxDuration": 30
    },
    "api/cron-payouts.js": {
      "maxDuration": 60
    },
    "api/cron-refresh-cache.js": {
      "maxDuration": 60
    },
    "api/cron-reconcile.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-accrue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron-aggregate",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-payouts",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron-refresh-cache",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron-reconcile",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron-accrue",
      "destination": "/api/cron-accrue"
    },
    {
      "source": "/api/cron-aggregate",
      "destination": "/api/cron-aggregate"
    },
    {
      "source": "/api/cron-diagnostics",
      "destination": "/api/cron-diagnostics"
    },
    {
      "source": "/api/cron-payouts",
      "destination": "/api/cron-payouts"
    },
    {
      "source": "/api/cron-refresh-cache",
      "destination": "/api/cron-refresh-cache"
    },
    {
      "source": "/api/cron-reconcile",
      "destination": "/api/cron-reconcile"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
