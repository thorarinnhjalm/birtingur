{
  "ignoreCommand": "npx turbo-ignore @ada/serving",
  "buildCommand": "pnpm build",
  "devCommand": "tsc --watch",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
