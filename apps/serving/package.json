{
  "name": "@ada/serving",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @ada/shared build && tsc && mkdir -p public/v1 && cp ../../packages/snippet/dist/snippet.js public/widget.js && cp ../../packages/widgets/dist/widgets.js public/v1/widgets.js",
    "dev": "tsx watch src/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@ada/shared": "workspace:*",
    "@hono/node-server": "^2.0.4",
    "@upstash/redis": "^1.31.0",
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@ada/snippet": "workspace:*",
    "@ada/widgets": "workspace:*",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
